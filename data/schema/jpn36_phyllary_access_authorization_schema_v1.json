{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JPN36 phyllary-access pilot deidentified authorization record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "authorization_record_id",
    "site_id",
    "population_id",
    "execution_authorized",
    "land_manager_authorization_status",
    "manipulation_authorization_status",
    "conservation_review_status",
    "terminal_collection_authorization_status",
    "viability_assay_authorization_status",
    "population_census_complete",
    "counted_flowering_individuals",
    "authorized_manipulation_head_quota",
    "authorized_terminal_collection_head_quota",
    "device_qualification_status",
    "device_qualification_record_id",
    "device_id",
    "material_lot",
    "frozen_target_access_gap_mm"
  ],
  "properties": {
    "protocol_version": {"const": "jpn36_phyllary_access_pilot_v1"},
    "authorization_record_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1},
    "population_id": {"type": "string", "minLength": 1},
    "execution_authorized": {"const": true},
    "land_manager_authorization_status": {"const": "approved"},
    "manipulation_authorization_status": {"const": "approved"},
    "conservation_review_status": {"const": "approved"},
    "terminal_collection_authorization_status": {"const": "approved"},
    "viability_assay_authorization_status": {"const": "approved"},
    "population_census_complete": {"const": true},
    "counted_flowering_individuals": {"type": "integer", "minimum": 1},
    "authorized_manipulation_head_quota": {"type": "integer", "minimum": 24},
    "authorized_terminal_collection_head_quota": {"type": "integer", "minimum": 24},
    "device_qualification_status": {"const": "passed"},
    "device_qualification_record_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "material_lot": {"type": "string", "minLength": 1},
    "frozen_target_access_gap_mm": {"type": "number", "exclusiveMinimum": 0}
  }
}
